// Generated by jenkinsfy from GitHub workflow 'CI'.
// Review every TODO(jenkinsfy) comment before using this pipeline.
// GitHub triggers: push (branches: main); pull_request.
// Use a Multibranch Pipeline with a GitHub/Git branch source to build these events.
pipeline {
    agent none
    options {
        disableConcurrentBuilds(abortPrevious: true)
    }
    parameters {
        choice(name: 'environment', choices: ['staging', 'dev', 'prod'], description: 'Target environment')
        booleanParam(name: 'dry-run', defaultValue: true, description: '')
    }
    triggers {
        cron('TZ=UTC\n0 3 * * 1')
    }
    environment {
        APP = 'demo'
        REGISTRY_TOKEN = credentials('REGISTRY_TOKEN')
    }
    stages {
        stage('lint') {
            agent { label 'ubuntu-latest' }
            steps {
                checkout scm
                sh 'make lint'
            }
        }
        stage('test') {
            matrix {
                axes {
                    axis {
                        name 'os'
                        values 'ubuntu-latest', 'windows-latest'
                    }
                    axis {
                        name 'node_version'
                        values '18', '20'
                    }
                }
                excludes {
                    exclude {
                        axis {
                            name 'os'
                            values 'windows-latest'
                        }
                        axis {
                            name 'node_version'
                            values '18'
                        }
                    }
                }
                stages {
                    stage('test') {
                        agent { label "${os}" }
                        steps {
                            checkout scm
                            // TODO(jenkinsfy): actions/setup-node@v4 (node-version: ${{ matrix.node-version }}): provide node via 'tools {}' or a docker agent
                            echo 'TODO(jenkinsfy): set up node'
                            // Test
                            sh '''
                                npm ci
                                npm test -- --node ${node_version}
                            '''
                        }
                    }
                }
            }
        }
        stage('build') {
            agent { label 'self-hosted && linux' }
            environment {
                VERSION = "1.0.${env.BUILD_NUMBER}"
            }
            options {
                timeout(time: 30, unit: 'MINUTES')
            }
            steps {
                checkout scm
                // Build
                withCredentials([string(credentialsId: 'NPM_TOKEN', variable: 'NPM_TOKEN')]) {
                    dir('app') {
                        sh 'make build VERSION=$VERSION SHA=${GIT_COMMIT}'
                    }
                }
                dir('app/dist') {
                    stash name: 'dist', includes: '**', allowEmpty: true
                    archiveArtifacts artifacts: '**', allowEmptyArchive: true
                }
            }
            post {
                failure {
                    // Notify failure
                    sh './notify.sh "${BRANCH_NAME} failed"'
                }
            }
        }
        stage('deploy') {
            agent {
                docker {
                    image 'alpine:3.20'
                    label 'ubuntu-latest'
                }
            }
            when {
                beforeAgent true
                expression { return (env.TAG_NAME ? 'refs/tags/' + env.TAG_NAME : 'refs/heads/' + env.BRANCH_NAME) == 'refs/heads/main' && params['dry-run'] != true }
            }
            steps {
                dir('out') {
                    unstash 'dist'
                }
                // Deploy
                script {
                    if (env.BRANCH_NAME.startsWith('release/') || env.GITHUB_EVENT_NAME == 'workflow_dispatch') {
                        sh """#!/bin/bash
set -eo pipefail
./deploy.sh --env "\${environment}" --token "\$REGISTRY_TOKEN"
echo "mode: ${(params['dry-run'] ? 'dry' : 'live')}"
"""
                    }
                }
            }
        }
    }
}
