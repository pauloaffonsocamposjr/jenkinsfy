// Generated by jenkinsfy from GitHub workflow 'CI'.
// Review every TODO(jenkinsfy) comment before using this pipeline.
// GitHub triggers: push (branches: main, dev); pull_request.
// Use a Multibranch Pipeline with a GitHub/Git branch source to build these events.
pipeline {
    agent none
    options {
        disableConcurrentBuilds(abortPrevious: true)
    }
    environment {
        GOPATH = '/tmp/go'
        GOCACHE = '/tmp/go-cache'
        GOLANGCI_LINT_CACHE = '/tmp/golangci-lint-cache'
        GOTOOLCHAIN = 'local'
    }
    stages {
        stage('Lint') {
            agent {
                docker {
                    image 'golangci/golangci-lint:v2.15.0'
                    label 'linux'
                }
            }
            options {
                timeout(time: 15, unit: 'MINUTES')
            }
            steps {
                checkout scm
                // gofmt
                sh 'make fmt-check'
                // go vet
                sh 'make vet'
                // golangci-lint
                sh 'make golangci'
                // go.mod is tidy
                sh 'make tidy-check'
                // actionlint
                sh 'make actionlint'
                // Jenkinsfile matches this workflow
                sh 'make jenkinsfile-check'
            }
        }
        stage('test') {
            matrix {
                axes {
                    axis {
                        name 'go'
                        values '1.22', '1.27'
                    }
                }
                stages {
                    stage('test') {
                        agent {
                            docker {
                                image "golang:${go}"
                                label 'linux'
                            }
                        }
                        options {
                            timeout(time: 15, unit: 'MINUTES')
                        }
                        steps {
                            checkout scm
                            // Test with race detector and coverage
                            sh 'make cover'
                            // Coverage summary
                            sh '''
                                go tool cover -func=coverage.out | tail -n 1
                                if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
                                  {
                                    echo "### Coverage (Go ${go})"
                                    echo '```'
                                    go tool cover -func=coverage.out
                                    echo '```'
                                  } >> "$GITHUB_STEP_SUMMARY"
                                fi
                            '''
                            stash name: "coverage-go${env.go}", includes: 'coverage.out,coverage.html', allowEmpty: true
                            archiveArtifacts artifacts: 'coverage.out,coverage.html', allowEmptyArchive: true
                        }
                    }
                }
            }
        }
        stage('Parallel: build, e2e') {
            parallel {
                stage('Build binaries') {
                    agent {
                        docker {
                            image 'golang:1.27'
                            label 'linux'
                        }
                    }
                    options {
                        timeout(time: 15, unit: 'MINUTES')
                    }
                    steps {
                        checkout scm
                        // Cross-compile
                        sh 'make dist'
                        dir('dist') {
                            stash name: 'dist', includes: '**', allowEmpty: false
                            archiveArtifacts artifacts: '**', allowEmptyArchive: false
                        }
                    }
                }
                stage('Jenkins end-to-end') {
                    agent { label 'linux' }
                    options {
                        timeout(time: 30, unit: 'MINUTES')
                    }
                    steps {
                        checkout scm
                        // Tool versions
                        sh 'go version && podman version'
                        // Lint and build converted pipelines on a real Jenkins
                        sh 'make e2e'
                    }
                    post {
                        always {
                            // Upload Jenkins console log
                            dir('test/jenkins') {
                                stash name: 'jenkins-console', includes: 'last-console.txt', allowEmpty: true
                                archiveArtifacts artifacts: 'last-console.txt', allowEmptyArchive: true
                            }
                        }
                    }
                }
            }
        }
        stage('Release') {
            agent { label 'linux' }
            options {
                timeout(time: 10, unit: 'MINUTES')
            }
            when {
                beforeAgent true
                expression { return (env.TAG_NAME ? 'refs/tags/' + env.TAG_NAME : 'refs/heads/' + env.BRANCH_NAME).startsWith('refs/tags/v') }
            }
            steps {
                checkout scm
                dir('dist') {
                    unstash 'dist'
                }
                // Release notes from CHANGELOG.md
                sh 'make release-notes V="${BRANCH_NAME}" > release-notes.md'
                // Check binaries report the tag
                sh '''
                    chmod +x dist/jenkinsfy_* # artifacts do not keep file modes
                    set -- dist/jenkinsfy_*_linux_amd64
                    out=$("$1" -version)
                    echo "$out"
                    [ "$out" = "jenkinsfy ${BRANCH_NAME}" ]
                '''
                // Publish GitHub release
                withCredentials([string(credentialsId: 'GITHUB_TOKEN', variable: 'GH_TOKEN')]) {
                    sh '''
                        prerelease=""
                        case "${BRANCH_NAME}" in *-*) prerelease="--prerelease" ;; esac
                        gh release create "${BRANCH_NAME}" dist/* \\
                          --title "jenkinsfy ${BRANCH_NAME}" \\
                          --notes-file release-notes.md --verify-tag $prerelease
                    '''
                }
            }
        }
    }
}
